# 保持脚本文件 LF 换行，避免 Windows CRLF 导致 shebang 解析失败
*.mjs text eol=lf
*.sh  text eol=lf

# schema baseline 与运行时 dump 逐字节比对；Windows autocrlf 检出成 CRLF 会被
# db:schema:check 误报为 schema 差异并阻断 pre-push，强制 LF。
*.baseline.sql text eol=lf

# E2E PDF fixture 含规范 xref 尾空格，必须按二进制处理，避免 diff --check 误报。
packages/desktop/test/e2e/fixtures/fs/**/*.pdf binary
# 文档查看器测试 PDF 同理：按字节解析 xref，换行转换会破坏偏移。
apps/drora-cli/packages/office-runtime/fixtures/*.pdf binary

# 上游许可原文与生成的声明按字节保存，不能自动转换换行或裁剪空白。
# 原文中的 License / ======= 是 Markdown 标题，不是合并冲突。
THIRD-PARTY-NOTICES.md -text -whitespace conflict-marker-size=32 linguist-generated=true
third-party/upstream/** -text -whitespace
third-party/native-search/licenses/** -text -whitespace
third-party/runtime/*.txt -text -whitespace
docs/knip/docs/LICENSE -text -whitespace
docs/knip/docs/licenses/** -text -whitespace
third-party/inventory.json linguist-generated=true

# 手机远控原版取证快照按字节保存（完整性清单见 packages/mobile-web/upstream/SHA256SUMS.txt；
# upstream/SHA256SUMS.txt 是完整性锚点），禁止 autocrlf 行尾改写。
packages/mobile-web/upstream/** -text -whitespace
packages/mobile-web/src/recovered/** -text -whitespace
packages/mobile-web/public/** -text -whitespace

# CUA helper 随包运行时按字节保存：runtime-manifest.json 钉住 entry/addon 的
# SHA-256（windowsCuaDevRuntime requireArtifactHash 校验），autocrlf 改写行尾
# 会让 Windows 本地打包/测试全部 fail-closed（分叉侧仅因 CI LF checkout 幸免）。
packages/zcode-cua-helper/runtime/** -text -whitespace
packages/zcode-cua-helper/native/*.node -text -whitespace
packages/zcode-cua/upstream/** -text -whitespace

# Gen UI runtime/vendor/license 由 manifest 钉住 SHA256；Windows autocrlf 不能改写发行字节。
# （上游 3.16.1 另有 vendor/** 单独 -text 规则，已被本条 assets/** -text -whitespace 覆盖。）
apps/drora-cli/packages/visualize-plugin/skills/visualize/assets/** -text -whitespace

# 宠物技能的上游脚本/许可由 provenance.json 逐文件校验，保留发行原始字节。
apps/drora-cli/packages/bundled-skills/skills/create-pet/** -text -whitespace
