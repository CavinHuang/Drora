{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 本次上游整合保留既有职责完整的实现；这些文件超 800 行只告警，不机械拆分。
      "files": [
        // 插件市场沿用上游存量大文件，只补充目录字段投影；不为行数机械拆分安装流程。
        "**/apps/drora-cli/packages/adapters/src/plugins/marketplace.ts",
        // MCP 连接入口沿用上游存量实现；连接屏障修复不为行数重排整个 adapter。
        "**/apps/drora-cli/packages/adapters/src/mcp/index.ts",
        "**/apps/drora-cli/packages/bootstrap/src/plugins.ts",
        "**/apps/drora-cli/packages/adapters/src/storage/session-store/migrations.ts",
        "**/apps/drora-cli/packages/adapters/src/storage/session-store/sqlite-session-store.ts",
        "**/apps/drora-cli/packages/bootstrap/src/app/create-app.ts",
        "**/apps/drora-cli/packages/bootstrap/src/app/session-facade.ts",
        "**/apps/drora-cli/packages/bootstrap/src/drora-protocol-v4/v4-gateway.ts",
        "**/apps/drora-cli/packages/bootstrap/src/drora-protocol/server.ts",
        "**/apps/drora-cli/packages/bootstrap/src/drora-protocol/session-mapper.ts",
        "**/apps/drora-cli/packages/bootstrap/src/drora-protocol/v4-bridge.ts",
        "**/apps/drora-cli/packages/contracts/src/interfaces/session-store.port.ts",
        // §21 C（2026-10-24）：team hub 有效行超 800（状态所有者单文件集中裁决，
        // 拆分归后续重构卡）——照 steering.ts 先例只 warn 不机械拆分。
        "**/apps/drora-cli/packages/core/src/team/hub.ts",
        "**/apps/drora-cli/packages/core/src/runtime/methods/steering.ts",
        "**/apps/drora-cli/packages/core/src/runtime/methods/turn.ts",
        "**/apps/drora-cli/packages/core/src/runtime/methods/turn-model-step.ts",
        // core 包内以 --no-ignore 运行时，oxlint 按 cwd 相对路径匹配同一组存量文件。
        "src/runtime/methods/steering.ts",
        "src/runtime/methods/turn.ts",
        "src/runtime/methods/turn-model-step.ts",
        "src/team/hub.ts",
        "**/packages/ui/src/remote-connection-flow/index.ts"
      ],
      "rules": {
        "max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      // drora-cua 的 server 模块是发行 bundle 的还原稿（结构忠实原编译产物，
      // 行数超限是还原粒度所致）；语义化拆分前先豁免行数上限，其余规则照常生效。
      "files": ["packages/zcode-cua/src/**/*.ts", "packages/zcode-cua-helper/src/**/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".claude/skills",
    ".agents/skills",
    "packages/formal-proof",
    "apps/drora-cli/**",
    "!apps/drora-cli/packages/core/src/persona/**",
    "!apps/drora-cli/packages/core/tests/persona/**",
    "!apps/drora-cli/packages/adapters/src/storage/persona/**",
    "!apps/drora-cli/packages/adapters/tests/persona/**",
    "!apps/drora-cli/packages/bootstrap/src/app/drora-persona/**",
    "!apps/drora-cli/packages/bootstrap/tests/persona/**",
    "!apps/drora-cli/packages/core/src/runtime/helpers/runtime-provider-request-messages.ts",
    "docs/electron",
    "packages/mobile-web/upstream",
    "packages/mobile-web/src/recovered",
    "packages/mobile-web/dist",
    "packages/mobile-web/remote-dist",
    "scripts/regression",
    "packages/zcode-cua/broker",
    "packages/zcode-cua/frame-contract",
    "packages/zcode-cua/mcp",
    "packages/zcode-cua/upstream",
    "packages/zcode-cua-helper/native/reverse",
    "packages/zcode-cua-helper/tools",
    "packages/desktop/scripts/prepare-agent-node-bundle.mjs",
    ".tmp-work",
    "**/.tmp-*"
  ]
}
