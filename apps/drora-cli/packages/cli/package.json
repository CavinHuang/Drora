{
  "name": "@drora/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for drora",
  "bin": {
    "drora": "./dist/drora.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/drora.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --filter @drora/cli... build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@drora/adapters": "workspace:*",
    "@drora/bootstrap": "workspace:*",
    "@drora/contracts": "workspace:*",
    "@drora/core": "workspace:*",
    "@drora/dynamic-workflow-runtime": "workspace:*",
    "@drora/i18n": "workspace:*",
    "@drora/provider-node": "workspace:*",
    "@drora/shared": "workspace:*",
    "@drora/shared-types": "workspace:*",
    "@drora/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
