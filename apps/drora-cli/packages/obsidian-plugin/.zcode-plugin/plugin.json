{
  "name": "obsidian",
  "version": "0.4.0",
  "description": "Obsidian Vault capability for Drora: hooks-based vault authorization, the resident knowledge server (index/search/review MCP), and the read-only Vault webview panel.",
  "author": {
    "name": "Z.ai"
  },
  "license": "MIT",
  "skills": "skills",
  "ui": {
    "surfaces": [
      {
        "id": "vault",
        "title": {
          "zh-CN": "Obsidian Vault",
          "en-US": "Obsidian Vault"
        },
        "icon": "book-open",
        "server": "knowledge",
        "resourceUri": "ui://obsidian/panel.html",
        "availability": "session"
      }
    ]
  },
  "mcpServers": {
    "knowledge": {
      "command": "node",
      "args": [
        "${DRORA_PLUGIN_ROOT}/dist/mcp/server.js"
      ],
      "cwd": "${DRORA_PROJECT_DIR}",
      "alwaysLoad": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${DRORA_PLUGIN_ROOT}/dist/hooks/session-start.mjs"
            ],
            "timeoutMs": 10000,
            "statusMessage": "注入 Obsidian Vault 上下文"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${DRORA_PLUGIN_ROOT}/dist/hooks/permission-request.mjs"
            ],
            "timeoutMs": 10000,
            "statusMessage": "校验 Obsidian Vault 写授权"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${DRORA_PLUGIN_ROOT}/dist/hooks/user-prompt-submit.mjs"
            ],
            "timeoutMs": 10000,
            "statusMessage": "注入 Obsidian Vault 焦点上下文"
          }
        ]
      }
    ]
  }
}
