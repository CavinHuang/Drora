{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@drora/obsidian-plugin",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Obsidian Vault capability for Drora: vault discovery/authorization, native agent file access via hooks, and the resident knowledge server (index/search/review stack, specs/obsidian-vault-phase2-true-extraction.md §3).",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-runtime.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/agent-access.test.mjs && node test/permission-path-policy.test.mjs && node test/hooks-e2e.mjs"
  },
  "dependencies": {
    "@drora/rpc": "link:../../../../packages/rpc",
    "@drora/shared": "link:../../../../packages/shared",
    "@modelcontextprotocol/server": "2.0.0",
    "onnxruntime-common": "1.30.0",
    "onnxruntime-node": "1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
