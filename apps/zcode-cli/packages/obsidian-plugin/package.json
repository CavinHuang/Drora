{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/obsidian-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Obsidian Vault capability for ZCode: discovery, secure Markdown CRUD, and note workflows, published as an official ZCode plugin.",
  "type": "module",
  "bin": {
    "obsidian-mcp": "./dist/mcp/server.js"
  },
  "main": "./dist/mcp/server.js",
  "types": "./dist/mcp/server.d.ts",
  "exports": {
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-mcp.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/vault-security.test.mjs && node test/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
