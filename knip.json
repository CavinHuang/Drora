{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [
        ".release-it.mjs",
        ".vscode/*.mjs",
        "scripts/check-workspace-freshness.mjs",
        "scripts/mise-run.mjs"
      ]
    },
    "packages/desktop": {
      "entry": [
        "electron-builder.config.js",
        "scripts/sign-windows-hook.cjs",
        "src/renderer/*.html",
        "src/renderer/cuaPermissionPanel.ts",
        "src/renderer/src/resource-manager.tsx"
      ]
    },
    "packages/server": {
      "entry": ["src/index.ts", "src/entry-stdio.ts", "build-remote.ts"]
    },
    "packages/relay-server": {
      "entry": ["src/index.ts", "src/main.ts", "test/*.test.ts"]
    },
    "packages/relay-client": {
      "entry": ["src/index.ts", "test/*.test.ts"]
    },
    "packages/mobile-web": {
      "entry": [
        "src/app/main.tsx",
        "scripts/recover.mjs",
        "scripts/build.mjs",
        "scripts/build-app.mjs",
        "test/*.test.mjs"
      ]
    },
    "packages/services": {
      "entry": ["src/index.ts", "src/storage/module.ts"]
    },
    "apps/drora-cli/packages/browser-use-plugin": {
      "entry": ["src/browser-client.ts"]
    }
  },
  "ignore": [
    ".agents/**",
    "docs/**",
    "packages/ui/src/components/**",
    "packages/mobile-web/upstream/**",
    "packages/mobile-web/src/recovered/**",
    "packages/mobile-web/dist/**"
  ]
}
