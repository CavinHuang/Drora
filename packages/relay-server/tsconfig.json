{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"]
  },
  "include": ["src"],
  // 依赖 @zcode/shared 的 relay-wire 区（spec D2 线协议同源化）；与 services/client
