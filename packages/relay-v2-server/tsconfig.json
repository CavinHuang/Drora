{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"],
  // 依赖 @drora/shared 的 web-remote-relay 契约区（spec §3：workspace:* 直接复用）；
