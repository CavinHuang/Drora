{
  "plans": {
    "x1-slow": [
      { "delayMs": 8000, "text": "慢慢输出的长回复。" }
    ],
    "x5-text": [
      { "text": "分叉锚点轮的回复。" }
    ]
  },
  "scenarios": [
    {
      "id": "x01",
      "title": "会话·stop：长轮中止→turn.completed cancelled",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_x01", "content": "慢慢回答 [[x1-slow]]" } },
        { "op": "sleep", "ms": 1500 },
        { "op": "request", "method": "session/stop", "params": { "sessionId": "$sessionId" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/usage", "params": { "sessionId": "$sessionId" } },
        { "op": "request", "method": "session/read", "params": { "sessionId": "$sessionId" } }
      ]
    },
    {
      "id": "x02",
      "title": "会话·subagents：空白面",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subagents", "params": { "sessionId": "$sessionId", "endedLimit": 20 } },
        { "op": "request", "method": "session/subagents", "params": { "sessionId": "sess_none", "endedLimit": 20 } }
      ]
    },
    {
      "id": "x03",
      "title": "会话·模型面：setModel/缺参 setThoughtLevel/updateRuntimeModelConfig 空参",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId", "$modelId": "session.model.modelId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/setModel",
          "params": { "sessionId": "$sessionId", "model": { "providerId": "anthropic", "modelId": "$modelId" }, "persistAsWorkspaceLastUsed": false } },
        { "op": "request", "method": "session/setThoughtLevel", "params": { "sessionId": "$sessionId" } },
        { "op": "request", "method": "session/updateRuntimeModelConfig",
          "params": { "sessionId": "$sessionId", "runtimeModel": { "revision": 0, "generatedAt": 0 }, "applyModelSelection": false } }
      ]
    },
    {
      "id": "x04",
      "title": "会话·cancelBackgroundTask：未知任务",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/cancelBackgroundTask", "params": { "sessionId": "$sessionId", "taskId": "task_none" } }
      ]
    },
    {
      "id": "x05",
      "title": "会话·fork turn0 锚点",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_x05", "content": "锚点轮 [[x5-text]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/fork", "timeoutMs": 30000,
          "params": { "sessionId": "$sessionId", "target": "turn0" } },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$forkedSessionId", "limit": 10 } }
      ]
    }
  ]
}
