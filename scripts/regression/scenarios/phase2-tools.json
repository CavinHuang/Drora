{
  "plans": {
    "t1-read-1": [
      { "toolCalls": [{ "name": "Read", "arguments": { "file_path": "$WS/note.txt" } }] },
      { "text": "读取完成：todo 一号。" }
    ],
    "t2-write-1": [
      { "toolCalls": [{ "name": "Write", "arguments": { "file_path": "$WS/out.txt", "content": "写入的确定性内容 A-1" } }] },
      { "text": "写入完成。" }
    ],
    "t3-bash-1": [
      { "toolCalls": [{ "name": "Bash", "arguments": { "command": "echo reg-bash-ok", "description": "确定性回声" } }] },
      { "text": "bash 完成。" }
    ],
    "t4-glob-1": [
      { "toolCalls": [{ "name": "Glob", "arguments": { "pattern": "**/*.txt", "path": "$WS" } }] },
      { "text": "glob 完成。" }
    ],
    "t5-grep-1": [
      { "toolCalls": [{ "name": "Grep", "arguments": { "pattern": "NEEDLE", "path": "$WS", "output_mode": "content" } }] },
      { "text": "grep 完成。" }
    ],
    "t6-edit-1": [
      { "toolCalls": [{ "name": "Edit", "arguments": { "file_path": "$WS/editable.txt", "old_string": "AAA", "new_string": "BBB" } }] },
      { "text": "编辑完成。" }
    ],
    "t7-todo-1": [
      { "toolCalls": [{ "name": "TodoWrite", "arguments": { "todos": [ { "content": "实现功能甲", "status": "in_progress", "priority": "high" }, { "content": "写测试乙", "status": "pending", "priority": "medium" } ] } }] },
      { "text": "待办已写。" }
    ],
    "t8-sub-main": [
      { "toolCalls": [{ "name": "Agent", "arguments": { "prompt": "用一句话回答：1+1=? 线索[[t8-sub]]", "description": "子代理计算", "subagent_type": "general-purpose" } }] },
      { "text": "父代理汇总完成。" }
    ],
    "t8-sub": [
      { "text": "子代理回答：2。" }
    ]
  },
  "scenarios": [
    {
      "id": "t01",
      "title": "工具·Read：读种子文件",
      "serial": true,
      "ops": [
        { "op": "writeFile", "path": "note.txt", "content": "todo 一号：回归台种子" },
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t01", "content": "读取 note.txt [[t1-read-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } }
      ]
    },
    {
      "id": "t02",
      "title": "工具·Write：写新文件",
      "serial": true,
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t02", "content": "写出 out.txt [[t2-write-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } }
      ]
    },
    {
      "id": "t03",
      "title": "工具·Bash：确定性回声（含权限面）",
      "serial": true,
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t03", "content": "跑一下回声 [[t3-bash-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } },
        { "op": "request", "method": "session/usage", "params": { "sessionId": "$sessionId" } }
      ]
    },
    {
      "id": "t04",
      "title": "工具·Glob：模式匹配",
      "serial": true,
      "ops": [
        { "op": "writeFile", "path": "a.txt", "content": "alpha" },
        { "op": "writeFile", "path": "sub/b.txt", "content": "beta" },
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t04", "content": "列出所有 txt [[t4-glob-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } }
      ]
    },
    {
      "id": "t05",
      "title": "工具·Grep：内容检索",
      "serial": true,
      "ops": [
        { "op": "writeFile", "path": "hay.txt", "content": "第一行\nNEEDLE 在这里\n第三行" },
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t05", "content": "找 NEEDLE [[t5-grep-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } }
      ]
    },
    {
      "id": "t06",
      "title": "工具·Edit：精确替换",
      "serial": true,
      "ops": [
        { "op": "writeFile", "path": "editable.txt", "content": "AAA 中间 BBB 结尾" },
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t06", "content": "把 AAA 换成 BBB [[t6-edit-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } }
      ]
    },
    {
      "id": "t07",
      "title": "工具·TodoWrite：待办投影",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t07", "content": "建两个待办 [[t7-todo-1]]" } },
        { "op": "waitEvent", "type": "turn.completed" },
        { "op": "request", "method": "session/read", "params": { "sessionId": "$sessionId" } }
      ]
    },
    {
      "id": "t08",
      "title": "工具·Agent：子代理全链（A2 溯源/子会话）",
      "ops": [
        { "op": "request", "method": "session/create", "capture": { "$sessionId": "session.sessionId" }, "timeoutMs": 30000,
          "params": { "workspace": { "workspacePath": "$WS", "workspaceKey": "$WS" } } },
        { "op": "request", "method": "session/subscribe", "params": { "sessionId": "$sessionId", "deliveryKind": "desktop-continuous", "includeSnapshot": false } },
        { "op": "request", "method": "session/send", "params": { "sessionId": "$sessionId", "inputId": "in_t08", "content": "派子代理算术 [[t8-sub-main]]" } },
        { "op": "waitEvent", "type": "turn.completed", "timeoutMs": 45000 },
        { "op": "request", "method": "session/subagents", "params": { "sessionId": "$sessionId", "endedLimit": 20 } },
        { "op": "request", "method": "session/messages", "params": { "sessionId": "$sessionId", "limit": 20 } }
      ]
    }
  ]
}
