  "scenarios": [
    {
      "id": "pa1",
      "title": "P0-2·inline 图片附件面：data:URL 图像直达模型（mock 请求面为证据）",
      "ops": [
        {
          "op": "request",
          "method": "session/create",
          "capture": {
            "$sessionId": "session.sessionId"
          },
          "timeoutMs": 30000,
          "params": {
            "workspace": {
              "workspacePath": "$WS",
              "workspaceKey": "$WS"
            }
          }
        },
        {
          "op": "request",
          "method": "session/subscribe",
          "params": {
            "sessionId": "$sessionId",
            "deliveryKind": "desktop-continuous",
            "includeSnapshot": false
          }
        },
        {
          "op": "request",
          "method": "session/send",
          "params": {
            "sessionId": "$sessionId",
            "inputId": "in_pa1",
            "content": "看这张图 [[pa1]] 说说里面有什么",
            "attachments": [
              {
                "type": "image",
                "content": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
              }
            ]
          }
        },
        {
          "op": "waitEvent",
          "type": "turn.completed"
        },
        {
          "op": "request",
          "method": "session/messages",
          "params": {
            "sessionId": "$sessionId",
            "limit": 20
          }
        }
      ]
    },
    {
      "id": "pa2",
      "title": "P1#98 仲裁·path 附件面：{type:file,path} 派发时读文件 vs 提示块渲染",
