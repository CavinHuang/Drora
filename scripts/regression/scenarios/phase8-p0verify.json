              {
                "type": "file",
                "path": "$WS/attach-note.txt"
              }
            ]
          }
        },
        {
          "op": "waitEvent",
          "type": "turn.completed"
        },
        {
          "op": "request",
          "method": "session/messages",
          "params": {
            "sessionId": "$sessionId",
            "limit": 20
          }
        }
      ]
