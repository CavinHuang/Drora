            "sessionId": "$sessionId",
            "deliveryKind": "desktop-continuous",
            "includeSnapshot": false
          }
        },
        {
          "op": "request",
          "method": "session/send",
          "params": {
            "sessionId": "$sessionId",
            "inputId": "in_pa2",
            "content": "读一下附件 [[pa2]]",
